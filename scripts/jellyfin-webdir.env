# Installed as /etc/default/jellyfin-webdir, loaded by the webdir.conf systemd
# drop-in AFTER /etc/default/jellyfin, so this value is the one that takes effect.
# Point this at the release symlink, not a specific release directory.
JELLYFIN_WEB_OPT="--webdir=/home/slickwarren/jellyfin-web/current"
